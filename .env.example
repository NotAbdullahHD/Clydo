# clydo — copy to .env and fill in.

DISCORD_TOKEN=your bot token
GUILD_ID=

# presence data for /userinfo is privileged. enable "presence intent" in the
# developer portal → bot → privileged gateway intents, then set this to true.
PRESENCE_INTENT=false

# prefix commands (`,sobs`) and /snipe text need the privileged message content
# intent. enable "message content intent" in the portal, then set this to true.
MESSAGE_INTENT=false

# message command prefix. defaults to a comma.
PREFIX=,

# optional: discord user id allowed to run owner-only prefix commands
# (ban / unban). the server owner can always run them.
OWNER_ID=
