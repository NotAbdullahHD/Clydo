# clydo — copy to .env and fill in.

DISCORD_TOKEN=your bot token
GUILD_ID=

# intents are read from the developer portal at boot (an intent's "limited" flag
# counts as on). leave these on auto; true/false force a choice and can break login.
PRESENCE_INTENT=auto
MESSAGE_INTENT=auto

# message command prefix. defaults to a comma.
PREFIX=,

# optional: discord user id allowed to run owner-only prefix commands
# (ban / unban). the server owner can always run them.
OWNER_ID=
