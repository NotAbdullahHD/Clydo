{
  "name": "slink",
  "version": "0.1.0",
  "private": true,
  "description": "slink — a minimalist discord bot. raw typography, zero emojis, strict lower-case.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
